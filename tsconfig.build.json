{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/index.ts", "src/components"],
  "exclude": ["node_modules", "dist", "src/**/*.stories.jsx", "src/**/*.stories.tsx", "src/**/*.mdx", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
